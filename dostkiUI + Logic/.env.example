# NOTE AI Environment Configuration

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=note_ai_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/note_ai_db
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT & Authentication
JWT_SECRET=super_secret_jwt_access_key_change_in_production_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_signing_key_32_chars

# AI & Embeddings Configuration
# Providers supported: openai, gemini, mock
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_DIMENSION=1536

# File Storage Configuration
# Driver: local or s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# AWS S3 (Optional if STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=note-ai-uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
